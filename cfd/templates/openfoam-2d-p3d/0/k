/*--------------------------------*- C++ -*----------------------------------*\
| Отличие от общего шаблона — условие для k НА ТЕЛЕ.                          |
|                                                                            |
| В общем шаблоне стоит kqRWallFunction, то есть нулевой градиент. Это        |
| высокорейнольдсовая постановка: она предполагает, что первая ячейка лежит в |
| логарифмическом слое (y+ порядка тридцати), и вязкий подслой не считается,  |
| а моделируется.                                                            |
|                                                                            |
| Эталонные сетки устроены наоборот: подслой РАЗРЕШЁН ячейками, y+ у нас      |
| 0.71 / 0.29 / 0.14 по ступеням. У стенки турбулентная энергия обязана       |
| обращаться в ноль, а нулевой градиент оставляет там значение соседней       |
| ячейки — и тем гуще, чем мельче сетка. Отсюда и наблюдалось: сопротивление  |
| РОСЛО с измельчением вместо того, чтобы сходиться (§13.26).                 |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform {{k}};

boundaryField
{
    farfield
    {
        type            freestream;
        freestreamValue uniform {{k}};
    }

    {{wall_patches}}
    {
        type            fixedValue;
        value           uniform 1e-12;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}
