#!/bin/sh
# Один случай от ГОТОВОЙ сетки до сил. Отличие от обычного Allrun ровно одно:
# сетка не строится, а читается — сюда приезжает чужой эталонный файл PLOT3D.
#
# Зачем: пока мы строим сетку сами, ошибка постановки сетки и ошибка
# решателя с моделью слиты в одну и разделить их нечем. На чужой сетке,
# посчитанной опубликованными кодами, остаётся только вторая.
set -e
cd "$(dirname "$0")"
mkdir -p log

echo "=== {{case_id}} / {{mesh_level}} (сетка {{grid_file}}) ==="

runApplication()
{
    app=$1; shift
    echo "--- $app $*"
    "$app" "$@" > "log/$app.log" 2>&1
}

runApplication plot3dToFoam -noBlank constant/{{grid_file}}
# Преобразования готовой сетки берутся из манифеста (mesh.grid_transform):
# у сеток NASA свои оси и своё направление потока, у наших собственных — наши.
{{grid_transform_block}}
runApplication topoSet
runApplication createPatch -overwrite
runApplication checkMesh -writeAllFields

if [ "{{n_proc}}" -gt 1 ]; then
    runApplication decomposePar
    echo "--- {{application}} на {{n_proc}} процессах"
    mpirun -np {{n_proc}} {{application}} -parallel > log/{{application}}.log 2>&1
    runApplication reconstructPar -latestTime
else
    runApplication {{application}}
fi

echo "=== готово: postProcessing/forces"
