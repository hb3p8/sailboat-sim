#!/bin/sh
# Один случай от ГОТОВОЙ сетки до сил. Отличие от обычного Allrun ровно одно:
# сетка не строится, а читается — сюда приезжает чужой эталонный файл PLOT3D.
#
# Зачем: пока мы строим сетку сами, ошибка постановки сетки и ошибка
# решателя с моделью слиты в одну и разделить их нечем. На чужой сетке,
# посчитанной опубликованными кодами, остаётся только вторая.
set -e
cd "$(dirname "$0")"
mkdir -p log

echo "=== {{case_id}} / {{mesh_level}} (сетка {{grid_file}}) ==="

runApplication()
{
    app=$1; shift
    echo "--- $app $*"
    "$app" "$@" > "log/$app.log" 2>&1
}

runApplication plot3dToFoam -noBlank constant/{{grid_file}}
# Оси источника: профиль в плоскости x-z, размах вдоль y. У нас размах вдоль
# z, поэтому поворот на 90° вокруг x. Без него угол атаки задавался бы не в
# той плоскости, и подъёмная сила ушла бы в компоненту, которую никто не
# смотрит.
runApplication transformPoints -rotate-x 90
# И РАЗВОРОТ НОСОМ К ПОТОКУ. У источника принято, что поток идёт в +X, и
# профиль лежит носком в нуле, кромкой в единице. У нас наоборот: поток идёт
# в −X (ax.onset_flow), и носок обязан смотреть в +X. Без разворота эталонная
# сетка обтекалась ЗАДОМ НАПЕРЁД — острая кромка вперёд, круглый носок в
# корму, — и решение выходило сорванным: Cl 0.371 вместо 1.078 при
# сошедшейся невязке. Заметили это по картинке, а не по числам, потому что
# сорванный ответ сам по себе выглядит правдоподобно.
#
# Поворот, а не отражение: отражение меняет ориентацию системы, и все нормали
# ушли бы внутрь. Профиль симметричен, поэтому поворот на 180° вокруг Z
# переводит его в себя же, меняя только направление хорды.
runApplication transformPoints -rotate-z 180
# Сдвиг возвращает хорду на отрезок [0, 1], как у наших собственных случаев:
# от этого зависит и центр приведения моментов, и центр давления в сводке.
runApplication transformPoints -translate "(1 0 0)"
runApplication topoSet
runApplication createPatch -overwrite
runApplication checkMesh -writeAllFields

if [ "{{n_proc}}" -gt 1 ]; then
    runApplication decomposePar
    echo "--- {{application}} на {{n_proc}} процессах"
    mpirun -np {{n_proc}} {{application}} -parallel > log/{{application}}.log 2>&1
    runApplication reconstructPar -latestTime
else
    runApplication {{application}}
fi

echo "=== готово: postProcessing/forces"
