/*--------------------------------*- C++ -*----------------------------------*\
| Отличие от общего шаблона ровно одно — РЕЛАКСАЦИЯ 0.7 вместо 0.9.           |
|                                                                            |
| Эталонная сетка построена ПО ТЕЛУ с разрешённым пограничным слоем, и        |
| размеры ячеек в ней разнятся на девять порядков: от микрона у обшивки до    |
| десятков метров у дальней границы в пятистах хордах. Наши декартовы сетки   |
| такого разброса не имеют, и релаксация 0.9 на них работает.                 |
|                                                                            |
| Здесь она не работает, и это ЗАМЕРЕНО, а не предположено (§13.23). На       |
| тонкой ступени при 0.9 невязка по скорости не садится, а гуляет: 9.8e-5 на  |
| пятидесятом шаге, 1.3e-4 на двухсотом, 3.5e-5 на четырёхсотом — размах      |
| вчетверо, и через тысячу с лишним шагов это кончилось разносом (невязка     |
| неразрывности 5.5e22, силы 1e28). При 0.7 на тех же шагах: 2.3e-5, 2.5e-5,  |
| 2.4e-5 — ровная полка вчетверо ниже.                                       |
|                                                                            |
| Симптом в упавшем прогоне указывал сюда же: GAMG упирался в потолок в 1000  |
| итераций и не решал давление. Не сетка виновата — у неё неортогональность   |
| 19.7° против наших 42…77°, — а то, что решение к ней подходило рывками.     |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-08;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    "(U|Urel|k|omega|epsilon|nuTilda)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      yes;

    residualControl
    {
        p               {{residual_tol}};
        U               {{residual_tol}};
        "(k|omega|epsilon|nuTilda)" {{residual_tol}};
    }
}

relaxationFactors
{
    equations
    {
        U               0.7;
        ".*"            0.7;
    }
}
