FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

// Время — первым порядком, и это отступление сделано после разноса.
//
// CrankNicolson 0.9 второго порядка точнее держит амплитуду колебания силы, но
// на числах Куранта больше единицы он лишь условно устойчив. На сорванном
// сечении это и вышло: в какой-то ячейке скорость подскочила, подстройка шага
// стала резать dt, и через три часа счёта шаг дошёл до 1e-104 при физическом
// времени 3.65 с. Диссипативный `Euler` устойчив безусловно; амплитуда с ним
// занижена, и это записано в отчёт как оговорка, а не спрятано.
ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         cellLimited Gauss linear 1;
}

// Без `bounded` — в отличие от стационарного случая. Поправка `bounded`
// вычитает невязку неразрывности из конвективного члена и нужна там, где поле
// ещё не сошлось; в нестационарном расчёте она искажает сам переходный
// процесс, ради которого всё и считается.
divSchemes
{
    default         none;
    div(phi,U)      Gauss linearUpwind grad(U);
    div(phi,k)      Gauss limitedLinear 1;
    div(phi,omega)  Gauss limitedLinear 1;
    div(phi,nuTilda) Gauss limitedLinear 1;
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method          meshWave;
}
