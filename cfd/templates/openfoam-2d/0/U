FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ({{U_x}} {{U_y}} {{U_z}});

boundaryField
{
    farfield
    {
        type            freestreamVelocity;
        freestreamValue uniform ({{U_x}} {{U_y}} {{U_z}});
    }

    {{wall_patches}}
    {
        type            noSlip;
    }

    frontAndBack
    {
        type            empty;
    }
}
