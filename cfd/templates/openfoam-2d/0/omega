FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform {{omega}};

boundaryField
{
    farfield
    {
        type            inletOutlet;
        inletValue      uniform {{omega}};
        value           uniform {{omega}};
    }

    {{wall_patches}}
    {
        type            omegaWallFunction;
        value           uniform {{omega}};
    }

    frontAndBack
    {
        type            empty;
    }
}
