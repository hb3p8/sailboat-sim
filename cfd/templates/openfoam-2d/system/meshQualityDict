FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      meshQualityDict;
}

// Перекрывает базовый порог ровно одной строкой, и это УЖЕСТОЧЕНИЕ, а не
// ослабление. У тонкого листа под углом снап тянет граничные грани по
// диагонали ячеек, и с базовым maxBoundarySkewness 20 сеточник спокойно
// оставлял грани со скошенностью 5, которые приёмка (checkMesh, порог 4)
// затем браковала: у design-сечений так выживали две последние рваные грани
// на стыке листа с плоскостями симметрии — при любой форме кромки. Порог
// сеточника обязан быть не мягче порога приёмки, иначе они спорят, и
// проигрывает всегда сетка.
//
// Правка живёт в шаблоне ДВУМЕРНЫХ сечений, а не в базовом: по базовому уже
// посчитаны кили и корпуса, и менять их сетки задним числом нельзя.
maxNonOrtho         65;
maxBoundarySkewness 4;
maxInternalSkewness 4;
maxConcave          80;
minVol              1e-13;
minTetQuality       1e-15;
minArea             -1;
minTwist            0.02;
minDeterminant      0.001;
minFaceWeight       0.02;
minVolRatio         0.01;
minTriangleTwist    -1;
nSmoothScale        4;
errorReduction      0.75;
