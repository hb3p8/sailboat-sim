FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform {{nut}};

boundaryField
{
    farfield
    {
        type            calculated;
        value           uniform {{nut}};
    }

    {{wall_patches}}
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }

    // Патчи-связи (symmetry, symmetryPlane, empty, wedge) получают свои
    // условия сами. Благодаря этому шаблоны с плоскостью симметрии не
    // держат своих копий полей: у них меняется только blockMeshDict.
    #includeEtc "caseDicts/setConstraintTypes"
}
