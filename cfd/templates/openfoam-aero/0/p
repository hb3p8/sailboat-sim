FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

// Кинематическое давление: p/rho. Отсюда и требование §3.7 записывать
// плотность рядом с коэффициентом — сама по себе величина здесь не в паскалях.
dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    farfield
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
    }

    {{wall_patches}}
    {
        type            zeroGradient;
    }

    // Патчи-связи (symmetry, symmetryPlane, empty, wedge) получают свои
    // условия сами. Благодаря этому шаблоны с плоскостью симметрии не
    // держат своих копий полей: у них меняется только blockMeshDict.
    #includeEtc "caseDicts/setConstraintTypes"
}
