FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Полупространство: домен обрезан сверху плоскостью z = {{dom_zmax}}, и эта
// грань — плоскость симметрии, а не граница потока.
//
// Один шаблон закрывает два разных вопроса, и это не совпадение: в обоих
// случаях тело зеркально относительно горизонтальной плоскости.
//
// ПЕРВОЕ: изолированное перо киля с корневой симметрией. У настоящего киля
// корень упирается в днище, и днище работает концевой шайбой; в симуляторе это
// учтено множителем 1.5 к геометрическому удлинению (`effective_ar`). Зеркало
// даёт удлинение ровно вдвое, то есть ВЕРХНЮЮ границу этого эффекта. Сравнение
// с симулятором на этом случае и показывает, насколько множитель 1.5 верен, —
// цифру, которую иначе взять неоткуда.
//
// ВТОРОЕ: корпус в режиме двойного тела. Плоскость симметрии ставится по КВЛ,
// надводная часть остаётся снаружи домена и отсекается сеточником сама.
// Волнообразования в такой постановке нет вовсе — и это не недостаток, а
// разделение: остаётся вязкое сопротивление и сопротивление формы, то есть
// ровно та часть `hullResistance`, которую можно проверить на ноутбуке. Что
// такая постановка НЕ проверяет — волновую часть — сказано в отчёте прямо.
//
// Поле здесь ни одно не переопределяется: условия на плоскости симметрии
// OpenFOAM ставит сам по `#includeEtc "caseDicts/setConstraintTypes"` в полях
// родительского шаблона.
scale   1;

vertices
(
    ({{dom_xmin}} {{dom_ymin}} {{dom_zmin}})
    ({{dom_xmax}} {{dom_ymin}} {{dom_zmin}})
    ({{dom_xmax}} {{dom_ymax}} {{dom_zmin}})
    ({{dom_xmin}} {{dom_ymax}} {{dom_zmin}})
    ({{dom_xmin}} {{dom_ymin}} {{dom_zmax}})
    ({{dom_xmax}} {{dom_ymin}} {{dom_zmax}})
    ({{dom_xmax}} {{dom_ymax}} {{dom_zmax}})
    ({{dom_xmin}} {{dom_ymax}} {{dom_zmax}})
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ({{n_x}} {{n_y}} {{n_z}}) simpleGrading (1 1 1)
);

edges ();

boundary
(
    mirror
    {
        type symmetryPlane;
        faces
        (
            (4 5 6 7)
        );
    }

    farfield
    {
        type patch;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (3 7 6 2)
            (0 3 2 1)
        );
    }
);

mergePatchPairs ();
