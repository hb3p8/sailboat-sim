FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      SRFProperties;
}

// Принудительное рыскание (§5, этап 5) считается во вращающейся системе — это
// численный аналог опыта на вращающемся плече. Так `r` задаётся ТОЧНО и
// остаётся постоянным, а решение получается установившимся; при свободном
// манёвре ни того, ни другого нет, и локализовать источник ошибки нечем.
//
// Ось — Z вверх, знак тот же, что у скорости рыскания в физике симулятора.
SRFModel        rpm;

origin          ({{cofr_x}} {{cofr_y}} {{cofr_z}});
axis            (0 0 1);

rpmCoeffs
{
    rpm         {{yaw_rpm}};
}
