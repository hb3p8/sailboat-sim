FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}

dimensions      [0 0 0 0 0 0 0];

// Ноль в начальном поле, вода наливается `setFields` по плоскости z = 0.
// Наливать прямо здесь нельзя: `internalField` однороден, а нужна именно
// граница раздела.
internalField   uniform 0;

boundaryField
{
    // Умолчание: вода никуда не девается через грань.
    farfield
    {
        type            zeroGradient;
    }

    // На проточных гранях граница поверхности должна ПРОХОДИТЬ сквозь неё,
    // сохраняя уровень. Именно для этого заведён variableHeightFlowRate:
    // обычный inletOutlet с inletValue 0 приносит внутрь ВОЗДУХ при любом
    // втекании, и домен опустошается (§13.16).
    "(inlet|outlet)"
    {
        type            variableHeightFlowRate;
        lowerBound      0.0;
        upperBound      1.0;
        value           uniform 0;
    }

    // Сверху втекать может только воздух — и это здесь верно, в отличие от
    // проточных граней.
    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }

    {{wall_patches}}
    {
        type            zeroGradient;
    }
}
