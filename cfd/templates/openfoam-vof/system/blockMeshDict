/*--------------------------------*- C++ -*----------------------------------*\
| Свободная поверхность требует РАЗНЫХ условий на разных гранях домена, и это |
| не удобство, а физика: снизу и с боков вода держится, сверху стоит воздух,  |
| спереди втекает, сзади вытекает. Одним патчем это не выражается.            |
|                                                                            |
| Цена одного патча измерена (§13.16): у наследованного от аэродинамики       |
| `farfield` стояло alpha.water как inletOutlet с inletValue 0, то есть любой |
| втекающий поток приносил ВОЗДУХ, а вытекающий уносил воду — обратной дороги |
| у воды не было по построению. Домен опустел наполовину за десять секунд,    |
| тело достояло расчёт в воздухе, и архимедова сила вышла 4 Н вместо 429.     |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

scale   1;

vertices
(
    ({{dom_xmin}} {{dom_ymin}} {{dom_zmin}})
    ({{dom_xmax}} {{dom_ymin}} {{dom_zmin}})
    ({{dom_xmax}} {{dom_ymax}} {{dom_zmin}})
    ({{dom_xmin}} {{dom_ymax}} {{dom_zmin}})
    ({{dom_xmin}} {{dom_ymin}} {{dom_zmax}})
    ({{dom_xmax}} {{dom_ymin}} {{dom_zmax}})
    ({{dom_xmax}} {{dom_ymax}} {{dom_zmax}})
    ({{dom_xmin}} {{dom_ymax}} {{dom_zmax}})
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ({{n_x}} {{n_y}} {{n_z}}) simpleGrading (1 1 1)
);

edges
(
);

// Ось X направлена В НОС, а набегающий поток идёт в корму (`ax.onset_flow`
// даёт Fx < 0). Значит вода ВТЕКАЕТ через носовую грань x = xmax и ВЫТЕКАЕТ
// через кормовую x = xmin. Перепутать их — это тихая ошибка, ровно того же
// рода, что разворот профиля в §13.20: расчёт пойдёт и что-то посчитает.
boundary
(
    // Группа `farfield` объединяет все внешние грани. Она нужна, чтобы поля,
    // которым разница между гранями безразлична (k, omega, nut, nuTilda),
    // наследовались от аэродинамического шаблона без единой правки: точное
    // имя патча в OpenFOAM перебивает групповое, поэтому там, где разница
    // важна, грань называется прямо.
    inlet
    {
        type patch;
        inGroups (farfield);
        faces ((1 2 6 5));          // x = xmax, в нос
    }
    outlet
    {
        type patch;
        inGroups (farfield);
        faces ((0 4 7 3));          // x = xmin, в корму
    }
    sides
    {
        type patch;
        inGroups (farfield);
        faces
        (
            (0 1 5 4)               // y = ymin
            (3 7 6 2)               // y = ymax
        );
    }
    bottom
    {
        type patch;
        inGroups (farfield);
        faces ((0 3 2 1));          // z = zmin, дно
    }
    atmosphere
    {
        type patch;
        inGroups (farfield);
        faces ((4 5 6 7));          // z = zmax, воздух сверху
    }
);

mergePatchPairs
(
);
